// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  cutting_supervisor
  cutting_verifier
  sewing_supervisor
}

enum OrderStatus {
  CUTTING_IN_PROGRESS
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SEWING_IN_PROGRESS
}

enum VerificationStatus {
  GREEN
  YELLOW
  RED
}

enum VerificationDecision {
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// TABLE: users
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          Role
  fullName      String   @map("full_name")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  cuttingOrders    CuttingOrder[]    @relation("CreatedBy")
  verificationLogs VerificationLog[] @relation("VerifiedBy")

  @@map("users")
}

// ─────────────────────────────────────────────
// TABLE: recipes
// ─────────────────────────────────────────────

model Recipe {
  id              String  @id @default(cuid())
  recipeCode      String  @unique @map("recipe_code")
  name            String
  category        String
  stdFabricYards  Float   @map("std_fabric_yards")
  wastageCap      Float   @map("wastage_cap")

  // Relations
  components    RecipeComponent[]
  cuttingOrders CuttingOrder[]

  @@map("recipes")
}

// ─────────────────────────────────────────────
// TABLE: recipe_components
// ─────────────────────────────────────────────

model RecipeComponent {
  id               String  @id @default(cuid())
  recipeId         String  @map("recipe_id")
  componentName    String  @map("component_name")
  piecesPerGarment Int     @map("pieces_per_garment")
  imageUrl         String? @map("image_url")

  // Relations
  recipe             Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  verificationItems  VerificationItem[]

  @@map("recipe_components")
}

// ─────────────────────────────────────────────
// TABLE: cutting_orders
// ─────────────────────────────────────────────

model CuttingOrder {
  id              String      @id @default(cuid())
  orderNo         String      @unique @map("order_no")
  recipeId        String      @map("recipe_id")
  targetQty       Int         @map("target_qty")
  fabricRollId    String      @map("fabric_roll_id")
  actualFabricYds Float       @map("actual_fabric_yds")
  status          OrderStatus @default(CUTTING_IN_PROGRESS)
  createdBy       String      @map("created_by")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  recipe            Recipe             @relation(fields: [recipeId], references: [id])
  creator           User               @relation("CreatedBy", fields: [createdBy], references: [id])
  verificationItems VerificationItem[]
  verificationLogs  VerificationLog[]

  @@map("cutting_orders")
}

// ─────────────────────────────────────────────
// TABLE: verification_items
// ─────────────────────────────────────────────

model VerificationItem {
  id          String             @id @default(cuid())
  orderId     String             @map("order_id")
  componentId String             @map("component_id")
  expectedQty Int                @map("expected_qty")
  actualQty   Int?               @map("actual_qty")
  status      VerificationStatus @default(GREEN)

  // Relations
  order     CuttingOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  component RecipeComponent @relation(fields: [componentId], references: [id])

  @@unique([orderId, componentId])
  @@map("verification_items")
}

// ─────────────────────────────────────────────
// TABLE: verification_logs  (immutable audit trail)
// ─────────────────────────────────────────────

model VerificationLog {
  id             String               @id @default(cuid())
  orderId        String               @map("order_id")
  verifierId     String               @map("verifier_id")
  decision       VerificationDecision
  rejectionNote  String?              @map("rejection_note")
  wastagePct     Float?               @map("wastage_pct")
  timestamp      DateTime             @default(now())

  // Relations
  order    CuttingOrder @relation(fields: [orderId], references: [id])
  verifier User         @relation("VerifiedBy", fields: [verifierId], references: [id])

  @@map("verification_logs")
}
